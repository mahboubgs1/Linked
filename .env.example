# ------------------------------------------------------------------
# LinkedIn Content Engine — environment configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit your real .env file. Credentials are read from env only.
# ------------------------------------------------------------------

# --- LinkedIn OAuth application credentials ---
# Create an app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# OAuth redirect URI registered on your LinkedIn app (used when OAuth is added).
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# --- LinkedIn access token (member or organization) ---
# Access token obtained via the OAuth 2.0 flow. Needed to publish.
LINKEDIN_ACCESS_TOKEN=

# Author URN that the post is published as.
# Person:       urn:li:person:XXXXXXXX
# Organization: urn:li:organization:XXXXXXXX
LINKEDIN_AUTHOR_URN=

# LinkedIn REST API version header (YYYYMM). Update as LinkedIn releases new versions.
LINKEDIN_API_VERSION=202401

# --- Publishing behavior ---
# When true, publishing is simulated (no real network call) even if a token is set.
# Useful for testing the approval workflow safely. Default: false.
LINKEDIN_DRY_RUN=false

# --- Logging ---
# Log verbosity: debug | info | warn | error. Default: info.
LOG_LEVEL=info
