# ------------------------------------------------------------------
# LinkedIn Content Engine — environment configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit your real .env file. Credentials are read from env only.
# ------------------------------------------------------------------

# --- LinkedIn OAuth application credentials ---
# Create an app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# OAuth redirect URI. Register this EXACT value on your LinkedIn app's Auth tab.
# `npm run login` starts a local server here to capture the login redirect.
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# OAuth scopes requested at login (space-separated). Defaults shown below.
# - openid, profile → read your member id (author URN) automatically
# - w_member_social → permission to post on your behalf
# Adjust to match the products approved on your LinkedIn app.
LINKEDIN_SCOPES=openid profile w_member_social

# --- LinkedIn access token (member or organization) ---
# OPTIONAL: `npm run login` obtains and stores a token for you automatically
# (in data/linkedin-token.json). Only set these if you prefer to paste a token
# manually or run in CI. When set, they take precedence over the stored token.
LINKEDIN_ACCESS_TOKEN=

# Author URN that the post is published as (auto-resolved by `npm run login`).
# Person:       urn:li:person:XXXXXXXX
# Organization: urn:li:organization:XXXXXXXX
LINKEDIN_AUTHOR_URN=

# LinkedIn REST API version header (YYYYMM). Update as LinkedIn releases new versions.
LINKEDIN_API_VERSION=202401

# --- Publishing behavior ---
# When true, publishing is simulated (no real network call) even if a token is set.
# Useful for testing the approval workflow safely. Default: false.
LINKEDIN_DRY_RUN=false

# --- Logging ---
# Log verbosity: debug | info | warn | error. Default: info.
LOG_LEVEL=info
